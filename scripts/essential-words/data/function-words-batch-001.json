{"version":1,"entries":[
{"word":"and","study":{"definitionEs":"Une palabras o ideas.","translation":["y"],"examples":[{"english":"Bread **and** butter.","translationEs":"Pan y mantequilla."}]}},
{"word":"to","study":{"definitionEs":"Indica destino o propósito.","translation":["a","para"],"usage":{"ruleEsOverride":"Para expresar propósito antes de un verbo, usa to; no for."},"contrasts":{"titleEs":"Propósito","pairs":[{"pattern":"replacement","spanish":"Vine **para** estudiar","english":"I came **to** study","explanationEs":"To va antes del verbo."}]},"examples":[{"english":"I want **to** go home.","translationEs":"Quiero ir a casa."}]}},
{"word":"a","teachWith":["an","the"],"study":{"definitionEs":"Artículo para una cosa no específica.","translation":["un","una"],"usage":{"ruleEsOverride":"Usa a antes de sonido de consonante y an antes de sonido de vocal."},"contrasts":{"titleEs":"Sonido siguiente","pairs":[{"pattern":"replacement","spanish":"Una **manzana**","english":"**An** apple","explanationEs":"Apple empieza con sonido vocal."}]},"examples":[{"english":"I need **a** pen.","translationEs":"Necesito un bolígrafo."}]}},
{"word":"it","teachWith":["i","you","he","she","we","they"],"study":{"definitionEs":"Pronombre para una cosa, animal o idea; también ocupa el sujeto vacío.","translation":["lo","ello"],"usage":{"ruleEsOverride":"En inglés se necesita it en expresiones como el clima."},"contrasts":{"titleEs":"Sujeto vacío","pairs":[{"pattern":"addition","spanish":"Llueve","english":"**It’s** raining","explanationEs":"El inglés necesita it."}]},"examples":[{"english":"I saw **it** yesterday.","translationEs":"Lo vi ayer."}]}},
{"word":"you","teachWith":["i","he","she","we","they","it"],"study":{"definitionEs":"Pronombre para la persona o personas a quienes hablas.","translation":["tú","usted","ustedes"],"usage":{"ruleEsOverride":"El inglés necesita expresar el sujeto."},"contrasts":{"titleEs":"Sujeto explícito","pairs":[{"pattern":"addition","spanish":"¿Vienes?","english":"Are **you** coming?","explanationEs":"No se omite you."}]},"examples":[{"english":"**You** are welcome.","translationEs":"De nada."}]}},
{"word":"he","teachWith":["i","you","she","we","they","it"],"study":{"definitionEs":"Pronombre para un hombre o niño.","translation":["él"],"usage":{"ruleEsOverride":"El inglés necesita expresar el sujeto."},"contrasts":{"titleEs":"Sujeto explícito","pairs":[{"pattern":"addition","spanish":"Trabaja aquí","english":"**He** works here","explanationEs":"No se omite he."}]},"examples":[{"english":"**He** is my brother.","translationEs":"Él es mi hermano."}]}},
{"word":"for","study":{"definitionEs":"Indica destinatario, beneficio o duración.","translation":["para","por"],"usage":{"ruleEsOverride":"Para destinatario o beneficio, usa for; para propósito antes de un verbo, usa to."},"contrasts":{"titleEs":"Destinatario","pairs":[{"pattern":"replacement","spanish":"Esto es **para** ti","english":"This is **for** you","explanationEs":"For indica para quién es algo."}]},"examples":[{"english":"This gift is **for** you.","translationEs":"Este regalo es para ti."}]}},
{"word":"they","teachWith":["i","you","he","she","we","it"],"study":{"definitionEs":"Pronombre para varias personas o cosas.","translation":["ellos","ellas"],"usage":{"ruleEsOverride":"El inglés necesita expresar el sujeto."},"contrasts":{"titleEs":"Sujeto explícito","pairs":[{"pattern":"addition","spanish":"Viven aquí","english":"**They** live here","explanationEs":"No se omite they."}]},"examples":[{"english":"**They** are ready.","translationEs":"Ellos están listos."}]}},
{"word":"we","teachWith":["i","you","he","she","they","it"],"study":{"definitionEs":"Pronombre para el hablante y otras personas.","translation":["nosotros","nosotras"],"usage":{"ruleEsOverride":"El inglés necesita expresar el sujeto."},"contrasts":{"titleEs":"Sujeto explícito","pairs":[{"pattern":"addition","spanish":"Vivimos aquí","english":"**We** live here","explanationEs":"No se omite we."}]},"examples":[{"english":"**We** live here.","translationEs":"Vivimos aquí."}]}},
{"word":"on","study":{"definitionEs":"En contacto con una superficie.","translation":["en","sobre"],"usage":{"ruleEsOverride":"Para una superficie, usa on; in es para dentro y at para un punto."},"contrasts":{"titleEs":"Lugar","pairs":[{"pattern":"replacement","spanish":"El libro está **en** la mesa","english":"The book is **on** the table","explanationEs":"On indica contacto con una superficie."}]},"examples":[{"english":"The cup is **on** the table.","translationEs":"La taza está sobre la mesa."}]}},
{"word":"with","study":{"definitionEs":"Indica compañía o relación.","translation":["con"],"usage":{"ruleEsOverride":"Con no siempre se traduce con with; depende del verbo."},"contrasts":{"titleEs":"Con un verbo","pairs":[{"pattern":"replacement","spanish":"Soñé **con** mi perro","english":"I dreamed **about** my dog","explanationEs":"Dream se usa con about."}]},"examples":[{"english":"I went **with** my friend.","translationEs":"Fui con mi amiga."}]}},
{"word":"this","teachWith":["that"],"study":{"definitionEs":"Señala algo cercano.","translation":["este","esta"],"usage":{"ruleEsOverride":"This es para algo cercano; that cubre ese y aquel."},"contrasts":{"titleEs":"Distancia","pairs":[{"pattern":"replacement","spanish":"**Ese** libro","english":"**That** book","explanationEs":"Para algo no cercano, usa that."}]},"examples":[{"english":"**This** is my bag.","translationEs":"Esta es mi bolsa."}]}},
{"word":"i","teachWith":["you","he","she","we","they","it"],"study":{"definitionEs":"Pronombre de la persona que habla.","translation":["yo"],"usage":{"ruleEsOverride":"El inglés necesita expresar el sujeto."},"contrasts":{"titleEs":"Sujeto explícito","pairs":[{"pattern":"addition","spanish":"Estoy listo","english":"**I** am ready","explanationEs":"No se omite I."}]},"examples":[{"english":"**I** am ready.","translationEs":"Estoy listo."}]}},
{"word":"as","study":{"definitionEs":"Indica función o papel.","translation":["como"],"usage":{"ruleEsOverride":"Para profesión o función, usa as; like expresa semejanza."},"contrasts":{"titleEs":"Función","pairs":[{"pattern":"replacement","spanish":"Trabaja **como** médico","english":"He works **as** a doctor","explanationEs":"As indica el papel de una persona."}]},"examples":[{"english":"Use it **as** a tool.","translationEs":"Úsalo como herramienta."}]}},
{"word":"at","study":{"definitionEs":"Indica un punto concreto de lugar o tiempo.","translation":["en","a"],"usage":{"ruleEsOverride":"At es un punto; in es dentro y on una superficie o día."},"contrasts":{"titleEs":"Lugar","pairs":[{"pattern":"replacement","spanish":"Nos vemos **en** la escuela","english":"Meet me **at** school","explanationEs":"At señala un punto de encuentro."}]},"examples":[{"english":"Meet me **at** the door.","translationEs":"Encuéntrame en la puerta."}]}},
{"word":"she","teachWith":["i","you","he","we","they","it"],"study":{"definitionEs":"Pronombre para una mujer o niña.","translation":["ella"],"usage":{"ruleEsOverride":"El inglés necesita expresar el sujeto."},"contrasts":{"titleEs":"Sujeto explícito","pairs":[{"pattern":"addition","spanish":"Vive aquí","english":"**She** lives here","explanationEs":"No se omite she."}]},"examples":[{"english":"**She** is my sister.","translationEs":"Ella es mi hermana."}]}},
{"word":"but","study":{"definitionEs":"Une una idea con otra que la contrasta.","translation":["pero"],"examples":[{"english":"Small **but** useful.","translationEs":"Pequeño pero útil."}]}},
{"word":"from","study":{"definitionEs":"Indica origen o punto de partida.","translation":["de","desde"],"usage":{"ruleEsOverride":"Para origen, usa from; no of."},"contrasts":{"titleEs":"Origen","pairs":[{"pattern":"replacement","spanish":"Soy **de** Perú","english":"I’m **from** Peru","explanationEs":"From indica origen."}]},"examples":[{"english":"She is **from** Lima.","translationEs":"Ella es de Lima."}]}},
{"word":"by","study":{"definitionEs":"Indica agente, medio o fecha límite.","translation":["por","en"],"usage":{"ruleEsOverride":"By se usa para agente, medio de transporte o fecha límite; no para duración."},"contrasts":{"titleEs":"Medio","pairs":[{"pattern":"replacement","spanish":"Voy **en** coche","english":"I go **by car**","explanationEs":"By indica el medio de transporte."}]},"examples":[{"english":"The book was written **by** Ana.","translationEs":"El libro fue escrito por Ana."}]}
}
]}
