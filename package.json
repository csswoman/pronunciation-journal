{
  "name": "pronunciation-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev --webpack",
    "content-index:generate": "tsx scripts/generate-content-index.ts",
    "prebuild": "pnpm content-index:generate",
    "build": "npm run lint:design-tokens && next build",
    "start": "next start",
    "lint": "eslint .",
    "check:migrations": "node scripts/check-migrations.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:rls": "node scripts/audit-rls.mjs",
    "lint:design-tokens": "node scripts/lint-design-tokens.mjs",
    "audit:ai-prompts": "node scripts/audit-ai-prompts.mjs",
    "audit:state-duplication": "node scripts/audit-state-duplication.mjs",
    "audit:hard-rules": "npm run audit:ai-prompts && npm run audit:rls && npm run lint:design-tokens && npm run audit:state-duplication",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:learning-loop:integration": "vitest run --config vitest.integration.config.ts lib/essential-words/__tests__/runtime-engine.integration.test.ts lib/learning-loop/__tests__/roundtrip.integration.test.ts --maxWorkers=1",
    "test:rls:integration": "node scripts/rls-integration.mjs",
    "test:srs-rating-events:integration": "node scripts/srs-rating-events-integration.mjs",
    "test:a11y": "playwright test",
    "validate:essential-words": "vitest run lib/essential-words/__tests__/dataset.test.ts",
    "essential-words:level-index": "node scripts/essential-words/generate-level-index.mjs",
    "validate:essential-words-generators": "vitest run lib/essential-words/__tests__/generatability.test.ts",
    "audit:sound-content": "tsx scripts/audit-sound-content.ts",
    "essential-words:gen-sentences": "tsx --env-file=.env.local scripts/essential-words/generate-example-sentences.mjs",
    "essential-words:apply-sentences": "node scripts/essential-words/apply-example-sentences.mjs",
    "audit:course-content": "vitest run lib/courses/__tests__/content-audit.test.ts lib/courses/__tests__/grammar-deck-coverage.test.ts",
    "audit:learning-loop": "tsx scripts/audit-learning-loop.mjs",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "analyze:bundle:check": "node scripts/analyze-bundle.mjs --check",
    "lexicon:enrich": "node scripts/enrich-lexicon.mjs --all"
  },
  "dependencies": {
    "@google/genai": "^2.9.0",
    "@serwist/next": "^9.5.11",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/postcss": "^4.3.1",
    "clsx": "^2.1.1",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "cuelume": "^0.1.2",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "fuse.js": "^7.5.0",
    "hyphen": "^1.14.1",
    "next": "^16.2.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "serwist": "^9.5.11",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "5.4.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/eslint-plugin-next": "^16.2.11",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.11",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": "24.x"
  }
}
