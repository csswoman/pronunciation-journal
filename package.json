{
  "name": "pronunciation-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev --webpack",
    "tokens": "tsx scripts/build-tokens.ts",
    "content-index:generate": "tsx scripts/generate-content-index.ts",
    "immersion-index:generate": "tsx --env-file-if-exists=.env.local scripts/generate-immersion-index.ts",
    "sync:engvid": "tsx --env-file-if-exists=.env.local scripts/sync-engvid-lessons.ts",
    "essential-words:catalog-index": "node scripts/essential-words/generate-catalog-index.mjs",
    "validate:chunk-catalog": "tsx scripts/chunks/validate-content-graph.ts",
    "prebuild": "pnpm content-index:generate && pnpm immersion-index:generate && pnpm essential-words:level-index && pnpm essential-words:catalog-index",
    "build": "npm run lint:design-tokens && next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check:listening-audio": "tsc --noEmit -p tsconfig.listening-audio.json",
    "generate:listening-audio": "tsx scripts/generate-listening-audio.ts",
    "ai:usage-report": "tsx --env-file-if-exists=.env.local scripts/ai-usage-report.ts",
    "prepush": "pnpm lint && pnpm type-check && pnpm audit:hard-rules && pnpm check:migrations && pnpm scan:secrets && pnpm audit:learning-loop && pnpm validate:chunk-catalog && pnpm test",
    "check:migrations": "node scripts/check-migrations.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:rls": "node scripts/audit-rls.mjs",
    "lint:design-tokens": "node scripts/lint-design-tokens.mjs",
    "lint:design": "node scripts/lint-design-tokens.mjs",
    "audit:ai-prompts": "node scripts/audit-ai-prompts.mjs",
    "audit:state-duplication": "node scripts/audit-state-duplication.mjs",
    "audit:hard-rules": "npm run audit:ai-prompts && npm run audit:rls && npm run lint:design-tokens && npm run audit:state-duplication",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:learning-loop:integration": "vitest run --config vitest.integration.config.ts lib/essential-words/__tests__/runtime-engine.integration.test.ts lib/essential-words/__tests__/runtime-writers.integration.test.ts lib/learning-loop/__tests__/roundtrip.integration.test.ts lib/learning-loop/__tests__/producer-roundtrip.integration.test.ts --maxWorkers=1",
    "test:rls:integration": "node scripts/rls-integration.mjs",
    "test:srs-rating-events:integration": "node scripts/srs-rating-events-integration.mjs",
    "test:a11y": "playwright test",
    "test:perf:cold-nav": "node scripts/clean-perf-port.mjs && playwright test --config=playwright.perf.config.ts",
    "validate:essential-words": "vitest run lib/essential-words/__tests__/dataset.test.ts",
    "essential-words:level-index": "node scripts/essential-words/generate-level-index.mjs",
    "validate:essential-words-generators": "vitest run lib/essential-words/__tests__/generatability.test.ts",
    "audit:sound-content": "tsx scripts/audit-sound-content.ts",
    "essential-words:gen-sentences": "tsx --env-file=.env.local scripts/essential-words/generate-example-sentences.mjs",
    "missions:pregen-audio": "tsx --env-file=.env.local scripts/pregenerate-mission-audio.ts",
    "essential-words:apply-sentences": "node scripts/essential-words/apply-example-sentences.mjs",
    "audit:course-content": "vitest run lib/courses/__tests__/content-audit.test.ts lib/courses/__tests__/grammar-deck-coverage.test.ts",
    "audit:learning-loop": "tsx --conditions=react-server scripts/audit-learning-loop.mjs",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "analyze:bundle:check": "node scripts/analyze-bundle.mjs --check",
    "measure:performance": "node scripts/measure-performance.mjs",
    "lexicon:enrich": "node scripts/enrich-lexicon.mjs --all"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "cuelume": "^0.1.2",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fuse.js": "^7.5.0",
    "hyphen": "^1.14.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "5.4.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@huggingface/transformers": "3.7.6",
    "@next/eslint-plugin-next": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "hyparquet": "1.31.1",
    "hyparquet-compressors": "1.1.2",
    "jsdom": "^29.1.1",
    "postcss": "8.5.25",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.x"
  }
}
