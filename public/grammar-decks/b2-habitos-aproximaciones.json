  "quiz": [
    {
      "q": "Which structure expresses a general tendency or present habit?",
      "options": [
        "tend to + infinitive",
        "used to + infinitive",
        "would + infinitive"
      ],
      "answer": 0,
      "explain": "'Tend to + infinitivo' se usa para describir hábitos o comportamientos habituales en el presente."
    },
    {
      "q": "How do you give an informal approximate time for a meeting around 7 o'clock?",
      "options": [
        "Let's meet at 7-ish.",
        "Let's meet at 7 sharp.",
        "Let's meet at 7 exactly."
      ],
      "answer": 0,
      "explain": "El sufijo informal '-ish' añadido a horas o números indica aproximación ('sobre las 7')."
    },
    {
      "q": "Which phrase gives a rough estimate of costs?",
      "options": [
        "Roughly around 500 euros",
        "Exactly 500 euros to the cent",
        "Without any budget limit"
      ],
      "answer": 0,
      "explain": "'Roughly' o 'approximately' señalan que la cifra dada es una estimación aproximada."
    }
  ]
