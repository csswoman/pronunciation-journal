  "quiz": [
    {
      "q": "Which verb is the correct collocation to use when you want to put a model into a production environment?",
      "options": [
        "deploy a model",
        "educate a model"
      ],
      "answer": 0,
      "explain": "En el contexto técnico, 'deploy' es el término correcto para poner un modelo en producción; nunca usamos 'educate' para referirnos a sistemas de IA."
    },
    {
      "q": "Complete the sentence: 'The new language model ___ generating creative content, but it often struggles with complex calculations.'",
      "options": [
        "is capable of",
        "is designed to"
      ],
      "answer": 0,
      "explain": "Usamos la estructura 'is capable of + -ing' para describir las habilidades o capacidades de un modelo."
    },
    {
      "q": "¿Cómo se pronuncia correctamente la sigla 'GPU' en una reunión técnica?",
      "options": [
        "Como una sola palabra: 'gupu'",
        "Deletreando cada letra: 'yi-pi-iu'"
      ],
      "answer": 1,
      "explain": "En inglés técnico, las siglas como GPU se deletrean individualmente para asegurar una comunicación clara y profesional."
