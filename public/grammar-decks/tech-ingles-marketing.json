  "quiz": [
    {
      "q": "Which term refers to the potential customers that a marketing campaign aims to attract?",
      "options": [
        "lead",
        "funnel"
      ],
      "answer": 0,
      "explain": "Un 'lead' es un cliente potencial, mientras que el 'funnel' es el proceso o embudo por el que pasan hasta la compra."
    },
    {
      "q": "If you want to describe a metric that has increased very quickly and significantly, which verb should you use?",
      "options": [
        "soar",
        "drop"
      ],
      "answer": 0,
      "explain": "El verbo 'soar' implica un aumento rápido y fuerte, mientras que 'drop' significa caer."
    },
    {
      "q": "Which phrase is the most appropriate to justify a marketing proposal based on analytics?",
      "options": [
        "The data suggests that...",
        "Don't miss out..."
      ],
      "answer": 0,
      "explain": "Usamos 'The data suggests that' para respaldar una idea con hechos, mientras que 'Don't miss out' es una técnica de urgencia para el cliente."
    }
