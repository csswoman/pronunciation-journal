      "id": "ie-task1",
      "tag": "Writing Task 1",
      "title": "Describir gráficos",
      "lede": "En el módulo académico describes datos. Selecciona las tendencias clave, no todo.",
      "blocks": [
        {
          "type": "rules",
          "rows": [
            {
              "key": "Tendencia",
              "value": "rose sharply · fell steadily · leveled off",
              "highlights": [
                "rose sharply"
              ]
            },
            {
              "key": "Comparar",
              "value": "whereas · compared to · while",
              "highlights": [
                "whereas"
              ]
            },
            {
              "key": "Resumen",
              "value": "Overall, the figures show...",
              "highlights": [
                "Overall"
              ]
            }
          ]
        }
      ],
      "tip": {
        "label": "Clave:",
        "body": "incluye siempre una frase de overview con la tendencia general: sube la banda."
      }
    },
    {
      "id": "ie-task2",
      "tag": "Writing Task 2",
      "title": "El ensayo de opinión",
      "lede": "Un ensayo de 250 palabras con postura clara, argumentos y conclusión.",
      "blocks": [
        {
          "type": "rules",
          "rows": [
            {
              "key": "Intro",
              "value": "It is often argued that... In this essay, I will...",
              "highlights": [
                "It is often argued that"
              ]
            },
            {
              "key": "Cuerpo",
              "value": "Firstly, ... Moreover, ... For example, ...",
              "highlights": [
                "Firstly"
              ]
            },
            {
              "key": "Conclusión",
              "value": "In conclusion, I firmly believe...",
              "highlights": [
                "In conclusion"
              ]
            }
          ]
        }
      ]
    },
